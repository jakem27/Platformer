<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.platformer.controller.HudController"
            prefHeight="100.0" prefWidth="350.0"
            style="-fx-background-color: transparent;">

    <HBox spacing="30" alignment="CENTER_LEFT"
          AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10">
        <Label fx:id="score"
               text="Score: 0"
               style="-fx-font-size: 20px; -fx-font-weight: bold;" />
    </HBox>

</AnchorPane>
